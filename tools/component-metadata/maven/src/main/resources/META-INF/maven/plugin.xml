<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>pnLibrary component metadata Maven plugin</name>
  <description>Embeds pnLibrary component identity and API compatibility into a JAR.</description>
  <groupId>io.github.pnfolder</groupId>
  <artifactId>pnlibrary-component-metadata-maven</artifactId>
  <version>@VERSION@</version>
  <goalPrefix>pnlibrary-component</goalPrefix>
  <requiredJavaVersion>8</requiredJavaVersion>
  <requiredMavenVersion>3.6.3</requiredMavenVersion>
  <mojos>
    <mojo>
      <goal>generate</goal>
      <description>Generates META-INF/pnlibrary/component.json.</description>
      <requiresDependencyResolution>runtime</requiresDependencyResolution>
      <requiresDependencyCollection>runtime</requiresDependencyCollection>
      <requiresDirectInvocation>false</requiresDirectInvocation>
      <requiresProject>true</requiresProject>
      <requiresReports>false</requiresReports>
      <aggregator>false</aggregator>
      <requiresOnline>false</requiresOnline>
      <inheritedByDefault>true</inheritedByDefault>
      <phase>process-resources</phase>
      <implementation>ru.privatenull.pnlibrary.metadata.maven.GenerateComponentMetadataMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter><name>apiMaximum</name><type>java.lang.Integer</type><required>false</required><editable>true</editable></parameter>
        <parameter><name>apiMinimum</name><type>int</type><required>true</required><editable>true</editable></parameter>
        <parameter><name>componentId</name><type>java.lang.String</type><required>false</required><editable>true</editable></parameter>
        <parameter><name>componentVersion</name><type>java.lang.String</type><required>false</required><editable>true</editable></parameter>
        <parameter><name>outputDirectory</name><type>java.io.File</type><required>true</required><editable>true</editable></parameter>
        <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><required>true</required><editable>false</editable></parameter>
      </parameters>
      <configuration>
        <apiMinimum implementation="int" default-value="1">${pnComponent.apiMinimum}</apiMinimum>
        <apiMaximum implementation="java.lang.Integer">${pnComponent.apiMaximum}</apiMaximum>
        <componentId implementation="java.lang.String">${pnComponent.id}</componentId>
        <componentVersion implementation="java.lang.String">${pnComponent.version}</componentVersion>
        <outputDirectory implementation="java.io.File" default-value="${project.build.outputDirectory}"/>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
      </configuration>
    </mojo>
  </mojos>
  <dependencies/>
</plugin>
